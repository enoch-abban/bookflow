# Drizzle
DATABASE_URL=file:./data/dev.db
# Only for a remote Turso database; leave empty for a local file.
DATABASE_AUTH_TOKEN=""
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Email (Resend). Leave RESEND_API_KEY empty in dev to print emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="bookflow <noreply@bookflow.app>"

# The daily job (late notices, email retries). Vercel sends it as a bearer token to /api/cron/daily.
# Any long random string; set the same value in the Vercel project's environment variables.
CRON_SECRET=""
